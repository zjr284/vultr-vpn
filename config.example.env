# ============================================================
#  vultr-vpn 配置
#  首次运行 setup.sh 会自动生成本文件（含随机密钥）。
#  本文件已被 .gitignore 忽略，请勿提交到任何仓库。
# ============================================================

# 域名（留空则自动用 <IP>.sslip.io）
# 建议用自己的域名，换 IP 时只需改一条 DNS A 记录
DOMAIN=""

# WireGuard 服务端
WG_PORT="51821"
WG_SERVER_PRIVKEY=""

# 三个客户端（私钥用于生成 clients/*.conf）
CLIENT_PHONE_PRIVKEY=""
CLIENT_WINDOWS_PRIVKEY=""
CLIENT_WSL_PRIVKEY=""

# Xray VLESS + Reality
XRAY_UUID=""
XRAY_PRIVKEY=""
XRAY_PUBKEY=""
XRAY_SHORTID=""
XRAY_SNI="www.yahoo.co.jp"

# Hysteria2
HY2_PASSWORD=""

# 订阅文件 token（URL 里的随机串）
SUB_TOKEN=""
